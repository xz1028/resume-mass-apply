# 就业海投简历系统 - 环境变量配置样例
# 使用方式：复制为 .env 并按需修改；全部配置项均有默认值，可零配置启动。
# 注意：环境变量需加前缀 RMA_，如 RMA_DAILY_DELIVERY_LIMIT=50

# ---- 简历档案 ----
# 允许的简历格式（JSON 数组）
#RMA_RESUME_ALLOWED_FORMATS=["pdf","doc","docx"]
# 单文件大小上限（MB）
#RMA_RESUME_MAX_SIZE_MB=20
# 简历加密存储目录
#RMA_RESUME_STORAGE_DIR=data/resumes

# ---- 定时任务周期 ----
# 职位拉取周期（小时，1-24；spec 要求不大于 24）
#RMA_JOB_FETCH_INTERVAL_HOURS=12
# 投递状态同步周期（小时，1-12；spec 要求不大于 12）
#RMA_STATUS_SYNC_INTERVAL_HOURS=6
# 过期职位清理周期（分钟）
#RMA_EXPIRE_CLEANUP_INTERVAL_MINUTES=60

# ---- 批量投递 ----
# 每日投递上限（默认 100）
#RMA_DAILY_DELIVERY_LIMIT=100
# 失败重试次数（spec 要求最多 2 次）
#RMA_RETRY_MAX_ATTEMPTS=2
# 重试退避秒数（指数退避 5s/15s）
#RMA_RETRY_BACKOFF_SECONDS=[5,15]
# 各平台限流策略（平台ID -> 每小时最大投递次数，JSON 对象）
# 平台 A 限制单账号每小时投递 30 次的配置示例：
#RMA_PLATFORM_RATE_LIMITS_PER_HOUR={"mock_platform":30,"zhilian":30,"boss":20}

# ---- 智能匹配 ----
# 匹配因子权重（技能/经验/城市/薪资）
#RMA_WEIGHT_SKILL=0.5
#RMA_WEIGHT_EXPERIENCE=0.2
#RMA_WEIGHT_CITY=0.15
#RMA_WEIGHT_SALARY=0.15
# 匹配结果缓存 TTL（秒）
#RMA_MATCHING_CACHE_TTL_SECONDS=600
# 自动投递匹配度阈值（0-100）
#RMA_AUTO_APPLY_THRESHOLD=60

# ---- 安全 ----
# AES-256-GCM 密钥文件路径（不存在时自动生成）
#RMA_SECRET_KEY_FILE=data/secret.key

# ---- 存储 ----
# 数据库连接（切换 PostgreSQL 仅需改此配置）
#RMA_DATABASE_URL=sqlite:///data/resume_mass_apply.db

# ---- 通知 ----
# 是否启用关键状态通知
#RMA_NOTIFICATION_ENABLED=true