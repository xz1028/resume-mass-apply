build/
release/
dist/

# Python 构建产物
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 测试与工具缓存
.pytest_cache/
.merkle-snapshot.json
.coverage
htmlcov/

# 本地环境配置（含真实凭证时勿提交；.env.example 为安全模板）
.env

